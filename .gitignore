# Original captures, photographs, COLMAP exports and IFC models stay local.
/assets/
/Assets/
/Screenshot*.png

# Environments, installed dependencies and generated native libraries.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
*.dylib
